{
  "name": "progressbeam",
  "author": "Archerkattri",
  "description": "Slim, accessible progress bar for browser applications",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archerkattri/progressbeam.git"
  },
  "homepage": "https://archerkattri.github.io/progressbeam/",
  "scripts": {
    "test": "mocha --timeout 10000 test/test.js",
    "test:browser": "playwright test",
    "test:package": "node test/package-smoke.cjs && node test/esm-smoke.mjs",
    "test:runtime": "node test/runtime-smoke.cjs",
    "test:packed": "node test/packed-smoke.cjs",
    "typecheck": "tsc --project test/tsconfig.json",
    "pack:check": "node test/pack-check.cjs"
  },
  "main": "progressbeam.js",
  "types": "progressbeam.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./progressbeam.d.ts",
      "import": {
        "node": "./progressbeam.js",
        "default": "./progressbeam.mjs"
      },
      "require": "./progressbeam.js",
      "default": "./progressbeam.js"
    },
    "./progressbeam.css": "./progressbeam.css",
    "./package.json": "./package.json"
  },
  "files": [
    "progressbeam.js",
    "progressbeam.mjs",
    "progressbeam.css",
    "progressbeam.d.ts",
    "docs/output-demo.gif",
    "docs/output-demo-dark.gif",
    "Readme.md",
    "MIGRATION.md",
    "License.md",
    "History.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.1",
    "typescript": "^7.0.2"
  }
}
