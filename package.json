{
  "name": "nprogress",
  "author": "Rico Sta. Cruz <hi@ricostacruz.com>",
  "description": "Simple slim progress bars",
  "version": "0.3.0-rc.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstacruz/nprogress.git"
  },
  "scripts": {
    "test": "mocha --timeout 10000 test/test.js",
    "test:browser": "playwright test",
    "test:package": "node test/package-smoke.cjs && node test/esm-smoke.mjs",
    "test:runtime": "node test/runtime-smoke.cjs",
    "test:packed": "node test/packed-smoke.cjs",
    "typecheck": "tsc --project test/tsconfig.json",
    "pack:check": "node test/pack-check.cjs"
  },
  "main": "nprogress.js",
  "types": "nprogress.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./nprogress.d.ts",
      "import": {
        "node": "./nprogress.js",
        "default": "./nprogress.mjs"
      },
      "require": "./nprogress.js",
      "default": "./nprogress.js"
    },
    "./nprogress.css": "./nprogress.css",
    "./package.json": "./package.json"
  },
  "files": [
    "nprogress.js",
    "nprogress.mjs",
    "nprogress.css",
    "nprogress.d.ts",
    "docs/output-demo.gif",
    "docs/output-demo-dark.gif",
    "Readme.md",
    "MIGRATION.md",
    "License.md",
    "History.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.1",
    "typescript": "^7.0.2"
  }
}
